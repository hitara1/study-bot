# Copy to .env and fill in. Never commit the real .env.
TELEGRAM_TOKEN=

# Fill in ONE of these. If both are set, NVIDIA is used unless AI_PROVIDER says otherwise.
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=

# Optional: force the provider ("nvidia" or "anthropic").
# AI_PROVIDER=nvidia

# Model name. Defaults: meta/llama-3.1-70b-instruct (NVIDIA), claude-sonnet-5-5 (Anthropic).
# For NVIDIA, copy the exact model ID from build.nvidia.com.
# AI_MODEL=

# Your Telegram ID(s), comma separated. Send /id to the bot to find yours.
# Leave empty only while testing: empty means anyone can use the bot.
ALLOWED_USER_IDS=

# Max AI requests per user per day.
AI_DAILY_LIMIT=40

BOT_TZ=Africa/Nairobi

# On Railway, point this at a mounted volume (e.g. /data/studybot.db) so data survives redeploys.
DB_PATH=studybot.db

# Optional: override who the AI thinks it is helping.
# STUDENT_CONTEXT=
